generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserType {
  SUPER_ADMIN
  ADMIN_EMPRESA
  USUARIO_EMPRESA
}

enum TipoMovimentacaoEstoque {
  ENTRADA
  SAIDA
  AJUSTE
  INVENTARIO
  TRANSFERENCIA_ENTRADA
  TRANSFERENCIA_SAIDA
}

enum StatusInventarioEstoque {
  ABERTO
  EM_CONTAGEM
  FINALIZADO
  CANCELADO
}

enum StatusItemInventario {
  PENDENTE
  CONTADO
}

enum StatusPedidoCompra {
  RASCUNHO
  PENDENTE_APROVACAO
  APROVADO
  PARCIALMENTE_RECEBIDO
  RECEBIDO
  CANCELADO
}

enum StatusItemPedidoCompra {
  PENDENTE
  PARCIALMENTE_RECEBIDO
  RECEBIDO
  CANCELADO
}

model Empresa {
  id        String   @id @default(uuid())
  nome      String
  cnpj      String?  @unique
  ativa     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usuarios             Usuario[]
  modulos              EmpresaModulo[]
  categoriasProduto    CategoriaProduto[]
  produtos             Produto[]
  estoquesProduto      EstoqueProduto[]
  movimentacoesEstoque MovimentacaoEstoque[]
  auditoriaLogs        AuditoriaLog[]
  agendaEventos        AgendaEvento[]
  clientes             Cliente[]
  fornecedores         Fornecedor[]
  ordensServico        OrdemServico[]
  marcasProdutos       MarcaProduto[]
  unidadesMedida       UnidadeMedida[]
  depositos            Deposito[]
  inventariosEstoque   InventarioEstoque[]
  pedidosCompra        PedidoCompra[]
}

model Usuario {
  id    String   @id @default(uuid())
  nome  String
  email String   @unique
  senha String
  tipo  UserType
  ativo Boolean  @default(true)

  empresaId String?
  empresa   Empresa? @relation(fields: [empresaId], references: [id])

  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  movimentacoesEstoque   MovimentacaoEstoque[]
  auditoriaLogs          AuditoriaLog[]
  agendaEventos          AgendaEvento[]
  agendaHistoricos       AgendaEventoHistorico[]
  clienteHistoricos      ClienteHistorico[]
  ordensResponsavel      OrdemServico[]
  ordemServicoHistoricos OrdemServicoHistorico[]
  produtoHistoricos      ProdutoHistorico[]
  fornecedorHistoricos   FornecedorHistorico[]
  inventariosAbertos     InventarioEstoque[]     @relation("InventarioUsuarioAbertura")
  inventariosConcluidos  InventarioEstoque[]     @relation("InventarioUsuarioConclusao")
  pedidosCompraCriados   PedidoCompra[]          @relation("PedidoCompraUsuarioCriacao")
  pedidosCompraAprovados PedidoCompra[]          @relation("PedidoCompraUsuarioAprovacao")
  pedidosCompraRecebidos PedidoCompra[]          @relation("PedidoCompraUsuarioRecebimento")
  pedidoCompraHistoricos PedidoCompraHistorico[]
}

model ModuloSistema {
  id        String  @id @default(uuid())
  nome      String  @unique
  chave     String  @unique
  descricao String?
  ativo     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empresas EmpresaModulo[]
}

model EmpresaModulo {
  id String @id @default(uuid())

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  moduloId String
  modulo   ModuloSistema @relation(fields: [moduloId], references: [id])

  ativo Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([empresaId, moduloId])
}

model CategoriaProduto {
  id        String  @id @default(uuid())
  nome      String
  descricao String?
  ativo     Boolean @default(true)

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  produtos  Produto[]

  @@unique([empresaId, nome])
}

model MarcaProduto {
  id        String  @id @default(uuid())
  nome      String
  descricao String?
  ativo     Boolean @default(true)

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  produtos Produto[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([empresaId, nome])
}

model UnidadeMedida {
  id    String  @id @default(uuid())
  nome  String
  sigla String
  ativo Boolean @default(true)

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  produtos Produto[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([empresaId, sigla])
}

model Deposito {
  id        String  @id @default(uuid())
  nome      String
  codigo    String
  descricao String?
  endereco  String?
  ativo     Boolean @default(true)

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  estoques      EstoqueProduto[]
  movimentacoes MovimentacaoEstoque[]
  inventarios   InventarioEstoque[]
  pedidosCompra PedidoCompra[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([empresaId, codigo])
  @@unique([empresaId, nome])
}

model Produto {
  id            String   @id @default(uuid())
  nome          String
  descricao     String?
  codigo        String?
  codigoBarras  String?
  ncm           String?
  precoCusto    Decimal  @default(0)
  precoVenda    Decimal  @default(0)
  peso          Decimal?
  altura        Decimal?
  largura       Decimal?
  comprimento   Decimal?
  estoqueMinimo Decimal  @default(0)
  estoqueMaximo Decimal?
  ativo         Boolean  @default(true)

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  categoriaId String?
  categoria   CategoriaProduto? @relation(fields: [categoriaId], references: [id])

  marcaId String?
  marca   MarcaProduto? @relation(fields: [marcaId], references: [id])

  unidadeMedidaId String?
  unidadeMedida   UnidadeMedida? @relation(fields: [unidadeMedidaId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  estoques             EstoqueProduto[]
  movimentacoesEstoque MovimentacaoEstoque[]
  historicos           ProdutoHistorico[]
  itensInventario      InventarioEstoqueItem[]
  itensPedidosCompra   PedidoCompraItem[]

  @@unique([empresaId, nome])
  @@unique([empresaId, codigo])
  @@unique([empresaId, codigoBarras])
}

model EstoqueProduto {
  id              String   @id @default(uuid())
  quantidadeAtual Decimal  @default(0)
  estoqueMinimo   Decimal  @default(0)
  estoqueMaximo   Decimal?
  custoMedio      Decimal  @default(0)
  ultimoCusto     Decimal  @default(0)

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  produtoId String
  produto   Produto @relation(fields: [produtoId], references: [id])

  depositoId String
  deposito   Deposito @relation(fields: [depositoId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([empresaId, produtoId, depositoId])
}

model MovimentacaoEstoque {
  id         String                  @id @default(uuid())
  tipo       TipoMovimentacaoEstoque
  quantidade Decimal
  observacao String?

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  produtoId String
  produto   Produto @relation(fields: [produtoId], references: [id])

  depositoId String?
  deposito   Deposito? @relation(fields: [depositoId], references: [id])

  usuarioId String?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])

  saldoAnterior       Decimal?
  saldoPosterior      Decimal?
  custoUnitario       Decimal?
  documentoReferencia String?

  createdAt DateTime @default(now())
}

model AuditoriaLog {
  id           String  @id @default(uuid())
  acao         String
  entidade     String
  entidadeId   String?
  dadosAntigos Json?
  dadosNovos   Json?
  ip           String?

  empresaId String?
  empresa   Empresa? @relation(fields: [empresaId], references: [id])

  usuarioId String?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])

  createdAt DateTime @default(now())
}

model AgendaEvento {
  id             String   @id @default(uuid())
  titulo         String
  descricao      String?
  dataInicio     DateTime
  dataFim        DateTime
  status         String   @default("AGENDADO")
  local          String?
  clienteNome    String?
  clienteContato String?
  ativo          Boolean  @default(true)

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  usuarioId String?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])

  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt
  historicos AgendaEventoHistorico[]

  clienteId     String?
  cliente       Cliente?       @relation(fields: [clienteId], references: [id])
  ordensServico OrdemServico[]
}

model AgendaEventoHistorico {
  id        String @id @default(uuid())
  descricao String

  agendaEventoId String
  agendaEvento   AgendaEvento @relation(fields: [agendaEventoId], references: [id])

  usuarioId String?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])

  createdAt DateTime @default(now())
}

model Cliente {
  id         String  @id @default(uuid())
  nome       String
  tipo       String  @default("PF")
  documento  String?
  email      String?
  telefone   String?
  celular    String?
  endereco   String?
  cidade     String?
  estado     String?
  cep        String?
  observacao String?
  ativo      Boolean @default(true)

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  agendaEventos AgendaEvento[]
  historicos    ClienteHistorico[]
  ordensServico OrdemServico[]
}

model ClienteHistorico {
  id        String @id @default(uuid())
  descricao String

  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id])

  usuarioId String?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])

  createdAt DateTime @default(now())
}

model OrdemServico {
  id            String    @id @default(uuid())
  numero        Int
  titulo        String
  descricao     String?
  status        String    @default("ABERTA")
  prioridade    String    @default("NORMAL")
  dataAbertura  DateTime  @default(now())
  dataPrevista  DateTime?
  dataConclusao DateTime?
  observacao    String?
  ativo         Boolean   @default(true)

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id])

  responsavelId String?
  responsavel   Usuario? @relation(fields: [responsavelId], references: [id])

  agendaEventoId String?
  agendaEvento   AgendaEvento? @relation(fields: [agendaEventoId], references: [id])

  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt
  historicos OrdemServicoHistorico[]
}

model OrdemServicoHistorico {
  id             String  @id @default(uuid())
  descricao      String
  statusAnterior String?
  statusNovo     String?

  ordemServicoId String
  ordemServico   OrdemServico @relation(fields: [ordemServicoId], references: [id])

  usuarioId String?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])

  createdAt DateTime @default(now())
}

model ProdutoHistorico {
  id        String @id @default(uuid())
  descricao String

  produtoId String
  produto   Produto @relation(fields: [produtoId], references: [id])

  usuarioId String?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])

  createdAt DateTime @default(now())
}

model InventarioEstoque {
  id            String                  @id @default(uuid())
  numero        Int
  descricao     String?
  observacao    String?
  status        StatusInventarioEstoque @default(ABERTO)
  dataAbertura  DateTime                @default(now())
  dataConclusao DateTime?

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  depositoId String
  deposito   Deposito @relation(fields: [depositoId], references: [id])

  usuarioAberturaId String?
  usuarioAbertura   Usuario? @relation("InventarioUsuarioAbertura", fields: [usuarioAberturaId], references: [id])

  usuarioConclusaoId String?
  usuarioConclusao   Usuario? @relation("InventarioUsuarioConclusao", fields: [usuarioConclusaoId], references: [id])

  itens InventarioEstoqueItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([empresaId, numero])
}

model InventarioEstoqueItem {
  id                String               @id @default(uuid())
  quantidadeSistema Decimal
  quantidadeContada Decimal?
  diferenca         Decimal?
  observacao        String?
  status            StatusItemInventario @default(PENDENTE)

  inventarioId String
  inventario   InventarioEstoque @relation(fields: [inventarioId], references: [id], onDelete: Cascade)

  produtoId String
  produto   Produto @relation(fields: [produtoId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([inventarioId, produtoId])
}

model Fornecedor {
  id String @id @default(uuid())

  razaoSocial  String
  nomeFantasia String?

  documento String

  inscricaoEstadual  String?
  inscricaoMunicipal String?

  email    String?
  telefone String?
  celular  String?
  contato  String?

  cep         String?
  endereco    String?
  numero      String?
  complemento String?
  bairro      String?
  cidade      String?
  estado      String?

  observacao String?

  ativo Boolean @default(true)

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  historicos    FornecedorHistorico[]
  pedidosCompra PedidoCompra[]

  @@unique([empresaId, documento])
  @@index([empresaId])
}

model FornecedorHistorico {
  id String @id @default(uuid())

  descricao String

  fornecedorId String
  fornecedor   Fornecedor @relation(fields: [fornecedorId], references: [id])

  usuarioId String?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])

  createdAt DateTime @default(now())
}

model PedidoCompra {
  id     String @id @default(uuid())
  numero Int

  status StatusPedidoCompra @default(RASCUNHO)

  dataPedido          DateTime  @default(now())
  dataPrevistaEntrega DateTime?
  dataAprovacao       DateTime?
  dataRecebimento     DateTime?

  observacao        String?
  observacaoInterna String?

  valorProdutos Decimal @default(0)
  valorDesconto Decimal @default(0)
  valorFrete    Decimal @default(0)
  valorOutros   Decimal @default(0)
  valorTotal    Decimal @default(0)

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  fornecedorId String
  fornecedor   Fornecedor @relation(fields: [fornecedorId], references: [id])

  depositoId String
  deposito   Deposito @relation(fields: [depositoId], references: [id])

  usuarioCriacaoId String?
  usuarioCriacao   Usuario? @relation("PedidoCompraUsuarioCriacao", fields: [usuarioCriacaoId], references: [id])

  usuarioAprovacaoId String?
  usuarioAprovacao   Usuario? @relation("PedidoCompraUsuarioAprovacao", fields: [usuarioAprovacaoId], references: [id])

  usuarioRecebimentoId String?
  usuarioRecebimento   Usuario? @relation("PedidoCompraUsuarioRecebimento", fields: [usuarioRecebimentoId], references: [id])

  itens      PedidoCompraItem[]
  historicos PedidoCompraHistorico[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([empresaId, numero])
  @@index([empresaId])
  @@index([fornecedorId])
  @@index([depositoId])
  @@index([status])
}

model PedidoCompraItem {
  id String @id @default(uuid())

  quantidadeSolicitada Decimal
  quantidadeRecebida   Decimal @default(0)

  valorUnitario Decimal
  valorDesconto Decimal @default(0)
  valorTotal    Decimal

  status StatusItemPedidoCompra @default(PENDENTE)

  pedidoCompraId String
  pedidoCompra   PedidoCompra @relation(fields: [pedidoCompraId], references: [id], onDelete: Cascade)

  produtoId String
  produto   Produto @relation(fields: [produtoId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([pedidoCompraId, produtoId])
  @@index([produtoId])
}

model PedidoCompraHistorico {
  id        String @id @default(uuid())
  descricao String

  pedidoCompraId String
  pedidoCompra   PedidoCompra @relation(fields: [pedidoCompraId], references: [id], onDelete: Cascade)

  usuarioId String?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])

  createdAt DateTime @default(now())

  @@index([pedidoCompraId])
}
